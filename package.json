{
  "name": "rally",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "build": "npm run typecheck && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "diff": "node scripts/pixel-diff.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "responsive": "node scripts/responsive-check.mjs",
    "build:hosted": "VITE_HOSTED=1 vite build --base=./ --outDir dist-hosted --emptyOutDir",
    "dev:api": "tsx --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "test:backend": "tsx --test server/*.test.ts",
    "test:live": "node scripts/live-e2e.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.322",
    "@fontsource/inter": "^5.2.6",
    "clsx": "^2.1.1",
    "fastify": "^5.12.8",
    "framer-motion": "14.7.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@playwright/test": "^1.53.2",
    "@tailwindcss/vite": "^4.1.11",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^10.0.7",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.1.11",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
